generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  SYSTEM_ADMIN
}

enum UserStatus {
  active
  disabled
}

enum Locale {
  en
  ar
}

enum ThemePreference {
  light
  dark
  system
}

enum LessonType {
  RICH_TEXT
  VIDEO
  PDF
  IMAGE
  EXTERNAL
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  locale    Locale   @default(en)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  grades        Grade[]
  classes       SchoolClass[]
  subjects      Subject[]
  students      Student[]
  teachers      Teacher[]
  units         Unit[]
  lessons       Lesson[]
  materials     LearningMaterial[]
  timetableSlots TimetableSlot[]
  assignments   Assignment[]
  submissions   AssignmentSubmission[]
  submissionFiles SubmissionFile[]
  lessonProgress LessonProgress[]
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  role         UserRole
  schoolId     String?         @db.Uuid
  locale       Locale          @default(en)
  theme        ThemePreference @default(system)
  status       UserStatus      @default(active)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  school              School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  student             Student?
  teacher             Teacher?

  @@index([schoolId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  name      String
  startsOn  DateTime?
  endsOn    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades Grade[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Grade {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  level          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classes      SchoolClass[]
  subjects     Subject[]

  @@unique([academicYearId, level])
  @@index([schoolId])
}

model SchoolClass {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  gradeId   String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade                Grade                 @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  enrollments          Enrollment[]
  teachingAssignments  TeachingAssignment[]
  timetableSlots       TimetableSlot[]
  assignments          Assignment[]
  units                Unit[]

  @@unique([gradeId, name])
  @@index([schoolId])
  @@map("Class")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  gradeId   String?  @db.Uuid
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade               Grade?               @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  teachingAssignments TeachingAssignment[]
  units               Unit[]
  assignments         Assignment[]
  timetableSlots      TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([gradeId])
}

model Student {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  userId     String   @unique @db.Uuid
  givenName  String
  familyName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  submissions  AssignmentSubmission[]
  progress     LessonProgress[]

  @@index([schoolId])
}

model Teacher {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  userId     String   @unique @db.Uuid
  givenName  String
  familyName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]

  @@index([schoolId])
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  studentId String   @db.Uuid
  classId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([schoolId])
  @@index([classId])
}

model TeachingAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  teacherId String   @db.Uuid
  subjectId String   @db.Uuid
  classId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
  @@index([schoolId])
  @@index([classId])
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  subjectId String   @db.Uuid
  classId   String?  @db.Uuid
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   SchoolClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([schoolId])
  @@index([subjectId])
}

model Lesson {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @db.Uuid
  unitId    String     @db.Uuid
  title     String
  type      LessonType
  body      String?
  url       String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  unit      Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  materials LearningMaterial[]
  progress  LessonProgress[]

  @@index([schoolId])
  @@index([unitId])
}

model LearningMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  lessonId    String   @db.Uuid
  storageKey  String
  fileName    String
  mimeType    String
  size        Int
  checksum    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([lessonId])
}

model TimetableSlot {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  classId   String   @db.Uuid
  subjectId String   @db.Uuid
  weekday   Int
  startsAt  String
  endsAt    String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId, weekday])
}

model Assignment {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @db.Uuid
  subjectId   String    @db.Uuid
  classId     String    @db.Uuid
  title       String
  instructions String
  dueAt       DateTime
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class       SchoolClass            @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
}

model AssignmentSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  assignmentId String           @db.Uuid
  studentId    String           @db.Uuid
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files      SubmissionFile[]

  @@unique([assignmentId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model SubmissionFile {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  submissionId String   @db.Uuid
  storageKey   String
  fileName     String
  mimeType     String
  size         Int
  checksum     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([submissionId])
}

model LessonProgress {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @db.Uuid
  studentId      String    @db.Uuid
  lessonId       String    @db.Uuid
  lastAccessedAt DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([schoolId])
}
