# Phase 1 — copy to .env and fill in values
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nabta:nabta@localhost:5432/nabta
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nabta.app
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nabta-files
MINIO_USE_SSL=false
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_WEB_URL=http://localhost:5173
